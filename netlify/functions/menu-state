import { getStore } from "@netlify/blobs";

const DEFAULT_STATE = {
  prepTime: "ca. 35 Minuten",
  soldOut: []
};

export default async (req) => {

  const store = getStore("nebu-sushi-state");

  if(req.method === "GET"){

    const data = await store.get("state", { type: "json" });

    return Response.json(data || DEFAULT_STATE);

  }

  if(req.method === "POST"){

    let body;

    try{
      body = await req.json();
    }catch(error){
      return Response.json({ error: "Ungültige Anfrage" }, { status: 400 });
    }

    const correctPassword = process.env.ADMIN_PASSWORD;

    if(!correctPassword || body.password !== correctPassword){

      return Response.json({ error: "Falsches Passwort" }, { status: 401 });

    }

    if(body.action === "verify"){

      return Response.json({ success: true });

    }

    const newState = {
      prepTime: typeof body.prepTime === "string" && body.prepTime.trim()
        ? body.prepTime.trim()
        : DEFAULT_STATE.prepTime,
      soldOut: Array.isArray(body.soldOut) ? body.soldOut : []
    };

    await store.set("state", JSON.stringify(newState));

    return Response.json({ success: true, state: newState });

  }

  return new Response("Method Not Allowed", { status: 405 });

};

export const config = {
  path: "/api/menu-state"
};

